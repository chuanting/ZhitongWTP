# 复制为 .env 后修改：cp .env.example .env
# 访问口令（必填）。生成一个随机的：openssl rand -base64 12
NETAI_ACCESS_PASSWORD=换成你自己的口令

# 会话签名密钥。不填则由口令派生；多副本部署必须显式设置：openssl rand -hex 32
NETAI_SECRET_KEY=

# 微调权重目录在宿主机上的路径（挂载为容器内 /models/weights）
# 留空或指向空目录时，应用回落到基座 amazon/chronos-2
WEIGHTS_DIR=/data/Zhitong_SDU_WT_LLM

# 走 HTTPS 时保持 1；仅内网 HTTP 测试可设为 0，否则 Cookie 不会被浏览器保存
NETAI_COOKIE_SECURE=1

# auto = 有 CUDA 用 CUDA，否则回落 CPU
NETAI_DEVICE=auto
